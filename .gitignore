# Secrets / machine-specific config
.env

# Data (re-downloaded and regenerated by the pipeline)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
dashboard/powerbi/data/*
!dashboard/powerbi/data/.gitkeep

# Model artifacts (regenerated by the pipeline)
models/*
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# Logs / OS / IDE
logs/
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
