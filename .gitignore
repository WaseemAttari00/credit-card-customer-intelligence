# Secrets / machine-specific config
.env

# Data (re-downloaded and regenerated by the pipeline)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artifacts (regenerated by the pipeline)
models/*
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# Logs / OS / IDE
logs/
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Power BI project: local data cache and machine-specific settings
**/.pbi/localSettings.json
**/.pbi/cache.abf
# Packaged Power BI file (17 MB binary with embedded data). The .pbip text files are the
# version-controlled source; the .pbix is attached to a GitHub Release instead.
*.pbix
