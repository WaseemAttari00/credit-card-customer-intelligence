# Copy to .env and fill in. .env is gitignored.
# Any PostgreSQL 13+ server works.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/cc_intel

# Only used by scripts/setup_local_postgres.ps1 (portable Postgres on Windows)
PG_HOME=C:\Users\<you>\AppData\Local\pgsql
PG_DATA=C:\Users\<you>\AppData\Local\pgsql_data
